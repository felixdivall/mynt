// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the example > compiles against the reference schema and runs: one lookup per reference, none for the loaded record 1`] = `
"/**
 * @NApiVersion 2.1
 * @NScriptType ScheduledScript
 * @NModuleScope SameAccount
 * Generated by Mynt from t.mn.
 */
define(["N/log", "N/record", "N/search"], (log, record, search) => {
    function execute(context) {
        const info = search.lookupFields({
            type: search.Type.CUSTOMER,
            id: 123,
            columns: ["email", "comments"]
        });

        const { email, comments: note } = info;

        log.debug({
            title: "execute",
            details: email
        });

        log.debug({
            title: "execute",
            details: note
        });

        const { entityid } = search.lookupFields({
            type: search.Type.CUSTOMER,
            id: 123,
            columns: ["entityid", "email"]
        });

        log.debug({
            title: "execute",
            details: entityid
        });

        const customer = record.load({
            type: record.Type.CUSTOMER,
            id: 123
        });

        const { comments } = {
            comments: customer.getValue({
                fieldId: "comments"
            }),
            email: customer.getValue({
                fieldId: "email"
            })
        };

        log.debug({
            title: "execute",
            details: comments
        });
    }

    return { execute };
});
"
`;
