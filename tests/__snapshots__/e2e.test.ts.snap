exports[`end to end: sublists > compiles the flagship example, parses, and crosses query, load, lines, and save 1`] = `
"/**
 * @NApiVersion 2.1
 * @NScriptType ScheduledScript
 * @NModuleScope SameAccount
 * Generated by Sail from examples/fix-quantities.sail.
 */
define(["N/query", "N/record"], (query, record) => {
    function sail$query(type, columns, condition) {
        const q = query.create({ type });
        q.columns = columns.map((fieldId) => q.createColumn({ fieldId, alias: fieldId }));
        if (condition) q.condition = condition(q);
        q.sort = [q.createSort({ column: q.columns[0], ascending: true })];
        const rows = [];
        const paged = q.runPaged({ pageSize: 1000 });
        paged.pageRanges.forEach((range) => {
            paged.fetch({ index: range.index }).data.results.forEach((result) => rows.push(result.asMap()));
        });
        return rows;
    }

    function execute(context) {
        const orders = sail$query(query.Type.SALES_ORDER, ["id"]);

        for (const row of orders) {
            const order = record.load({
                type: record.Type.SALES_ORDER,
                id: row.id
            });

            for (
                let line$index = 0;
                line$index < order.getLineCount({ sublistId: "item" });
                line$index += 1
            ) {
                if (
                    order.getSublistValue({
                        sublistId: "item",
                        fieldId: "quantity",
                        line: line$index
                    }) < 1
                ) {
                    order.setSublistValue({
                        sublistId: "item",
                        fieldId: "quantity",
                        line: line$index,
                        value: 1
                    });
                }
            }

            order.save();
        }
    }

    return { execute };
});
"
`;

exports[`end to end: user event with logging > logs and mutates the record, and infers N/log 1`] = `
"/**
 * @NApiVersion 2.1
 * @NScriptType UserEventScript
 * @NModuleScope SameAccount
 * Generated by Sail from examples/customer-logged.sail. Target record: customer.
 */
define(["N/log"], (log) => {
    function beforeSubmit(context) {
        if (context.type !== context.UserEventType.CREATE) {
            return;
        }

        const customer = context.newRecord;

        log.audit({
            title: "beforeSubmit",
            details: "Customer create"
        });

        customer.setValue({
            fieldId: "comments",
            value: "Managed by Sail"
        });
    }

    return { beforeSubmit };
});
"
`;
