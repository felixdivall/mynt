exports[`end to end: functions > compiles the flagship example to plain functions and runs it 1`] = `
"/**
 * @NApiVersion 2.1
 * @NScriptType ScheduledScript
 * @NModuleScope SameAccount
 * Generated by Sail from examples/review-orders.sail.
 */
define(["N/query", "N/record"], (query, record) => {
    function sail$query(type, columns, condition) {
        const q = query.create({ type });
        q.columns = columns.map((fieldId) => q.createColumn({ fieldId, alias: fieldId }));
        if (condition) q.condition = condition(q);
        q.sort = [q.createSort({ column: q.columns[0], ascending: true })];
        const rows = [];
        const paged = q.runPaged({ pageSize: 1000 });
        paged.pageRanges.forEach((range) => {
            paged.fetch({ index: range.index }).data.results.forEach((result) => rows.push(result.asMap()));
        });
        return rows;
    }

    function removeEmptyLines(order) {
        let line$index = 0;
        while (line$index < order.getLineCount({ sublistId: "item" })) {
            let line$removed = false;

            if (
                order.getSublistValue({
                    sublistId: "item",
                    fieldId: "quantity",
                    line: line$index
                }) === 0
            ) {
                order.removeLine({
                    sublistId: "item",
                    line: line$index
                });
                line$removed = true;
            }

            if (!line$removed) {
                line$index += 1;
            }
        }
    }

    function needsReview(memo) {
        return memo === "" || memo === "TBD";
    }

    function execute(context) {
        for (const row of sail$query(query.Type.SALES_ORDER, ["id"])) {
            const order = record.load({
                type: record.Type.SALES_ORDER,
                id: row.id
            });

            removeEmptyLines(order);

            if (
                needsReview(
                    order.getValue({
                        fieldId: "memo"
                    })
                )
            ) {
                order.setValue({
                    fieldId: "memo",
                    value: "Reviewed by Sail"
                });
            }

            order.save();
        }
    }

    return { execute };
});
"
`;

