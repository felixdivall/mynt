});
"
`;

exports[`end to end: Sail -> SuiteScript -> fake NetSuite > matches the expected generated SuiteScript 1`] = `
"/**
 * @NApiVersion 2.1
 * @NScriptType UserEventScript
 * @NModuleScope SameAccount
 * Generated by Sail from examples/customer.sail. Target record: customer.
 */
define([], () => {
    function beforeSubmit(context) {
        if (
            context.type !== context.UserEventType.CREATE &&
            context.type !== context.UserEventType.EDIT
        ) {
            return;
        }

        const customer = context.newRecord;

        customer.setValue({
            fieldId: "comments",
            value: "Managed by Sail"
        });
    }

    return { beforeSubmit };
});
"
`;

exports[`end to end: add and remove lines > constructs a sales order with two lines and persists them on save 1`] = `
"/**
 * @NApiVersion 2.1
 * @NScriptType ScheduledScript
 * @NModuleScope SameAccount
 * Generated by Sail from examples/build-order.sail.
 */
define(["N/record"], (record) => {
    function execute(context) {
        const order = record.create({
            type: record.Type.SALES_ORDER
        });

        {
            const item$line = order.getLineCount({ sublistId: "item" });
            order.insertLine({ sublistId: "item", line: item$line });
            order.setSublistValue({
                sublistId: "item",
                fieldId: "item",
                line: item$line,
                value: "100"
            });
            order.setSublistValue({
                sublistId: "item",
                fieldId: "quantity",
                line: item$line,
                value: 2
            });
            order.setSublistValue({
                sublistId: "item",
                fieldId: "rate",
                line: item$line,
                value: 10
            });
        }

        {
            const item$line = order.getLineCount({ sublistId: "item" });
            order.insertLine({ sublistId: "item", line: item$line });
            order.setSublistValue({
                sublistId: "item",
                fieldId: "item",
                line: item$line,
                value: "200"
            });
            order.setSublistValue({
                sublistId: "item",
                fieldId: "quantity",
                line: item$line,
                value: 1
            });
            order.setSublistValue({
                sublistId: "item",
                fieldId: "rate",
                line: item$line,
                value: 25
            });
        }

        order.save();
    }

    return { execute };
});
"
`;

exports[`end to end: add and remove lines > removes exactly the zero-quantity lines, including adjacent ones, in forward order 1`] = `
"/**
 * @NApiVersion 2.1
 * @NScriptType ScheduledScript
 * @NModuleScope SameAccount
 * Generated by Sail from examples/clean-order.sail.
 */
define(["N/record"], (record) => {
    function execute(context) {
        const order = record.load({
            type: record.Type.SALES_ORDER,
            id: "123"
        });

        let line$index = 0;
        while (line$index < order.getLineCount({ sublistId: "item" })) {
            let line$removed = false;

            if (
                order.getSublistValue({
                    sublistId: "item",
                    fieldId: "quantity",
                    line: line$index
                }) === 0
            ) {
                order.removeLine({
                    sublistId: "item",
                    line: line$index
                });
                line$removed = true;
            }

            if (!line$removed) {
                line$index += 1;
            }
        }

        order.save();
    }

    return { execute };
});
"
`;

