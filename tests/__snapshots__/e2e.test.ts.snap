exports[`end to end: Boolean composition > compiles both examples to the expected SuiteScript 1`] = `
"/**
 * @NApiVersion 2.1
 * @NScriptType ScheduledScript
 * @NModuleScope SameAccount
 * Generated by Sail from examples/review-customer.sail.
 */
define(["N/record"], (record) => {
    function execute(context) {
        const customer = record.load({
            type: record.Type.CUSTOMER,
            id: "123"
        });

        if (
            customer.getValue({
                fieldId: "email"
            }) === "" ||
            customer.getValue({
                fieldId: "comments"
            }) === "Blocked"
        ) {
            customer.setValue({
                fieldId: "comments",
                value: "Needs review"
            });

            customer.save();
        }
    }

    return { execute };
});
"
`;

