// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`lookup: local receivers > the flagship example compiles, infers N/record and N/search, and runs 1`] = `
"/**
 * @NApiVersion 2.1
 * @NScriptType ScheduledScript
 * @NModuleScope SameAccount
 * Generated by Mynt from examples/lookup-customer.mn.
 */
define(["N/log", "N/record", "N/search"], (log, record$, search) => {
    function execute(context) {
        const customer = "123";

        const email = search.lookupFields({
            type: search.Type.CUSTOMER,
            id: customer,
            columns: ["email"]
        }).email;

        log.debug({
            title: "execute",
            details: email
        });

        const info = search.lookupFields({
            type: search.Type.CUSTOMER,
            id: customer,
            columns: ["email", "comments"]
        });

        log.debug({
            title: "execute",
            details: info.comments
        });

        if (info.email === "") {
            const record = record$.load({
                type: record$.Type.CUSTOMER,
                id: customer
            });

            record.setValue({
                fieldId: "email",
                value: "unknown@example.com"
            });

            record.save();
        }
    }

    return { execute };
});
"
`;

exports[`search: an explicit N/search backend > the flagship example runs: filters, row fields, load by row id, save 1`] = `
"/**
 * @NApiVersion 2.1
 * @NScriptType ScheduledScript
 * @NModuleScope SameAccount
 * Generated by Mynt from examples/search-customers.mn.
 */
define(["N/log", "N/record", "N/search"], (log, record, search) => {
    function mynt$results(s, cols, columns, references, limit) {
        const rows = [];
        const paged = s.runPaged({ pageSize: limit ? Math.max(5, Math.min(limit, 1000)) : 1000 });
        paged.pageRanges.forEach((range) => {
            if (limit && rows.length >= limit) return;
            paged.fetch({ index: range.index }).data.forEach((result) => {
                if (limit && rows.length >= limit) return;
                rows.push(mynt$row(result, cols, columns, references));
            });
        });
        return rows;
    }

    function mynt$first(s, cols, columns, references) {
        const results = s.run().getRange({ start: 0, end: 1 });
        return results.length > 0 ? mynt$row(results[0], cols, columns, references) : null;
    }

    function mynt$row(result, cols, columns, references) {
        const row = columns.some((spec) => typeof spec !== "string" && spec.summary) ? {} : { id: result.id };
        cols.forEach((column, index) => {
            const spec = typeof columns[index] === "string" ? { name: columns[index] } : columns[index];
            if (spec.hidden) return;
            const key = spec.alias ? spec.alias : spec.field ? spec.field + "." + spec.name : spec.name;
            let value = result.getValue(column);
            if (spec.alias) {
                row[spec.alias] = value;
                return;
            }
            if (references.indexOf(key) >= 0) {
                const text = result.getText(column);
                value = { id: value === null || value === undefined ? "" : String(value), text: text === null || text === undefined ? "" : String(text) };
            }
            if (spec.field) {
                row[spec.field] = row[spec.field] || {};
                row[spec.field][spec.name] = value;
            } else if (references.indexOf(key) >= 0) {
                row[spec.name] = Object.assign(row[spec.name] || {}, value);
            } else {
                row[spec.name] = value;
            }
        });
        return row;
    }

    function mynt$search(type, columns, references, filters, limit, first) {
        const cols = mynt$columns(columns);
        const summary = columns.some((spec) => typeof spec !== "string" && spec.summary);
        const sorted = cols.filter((column) => column.sort);
        const unsorted = cols.filter((column) => !column.sort);
        let tiebreak = [];
        if (summary) {
            tiebreak = unsorted.filter((column) => column.summary === search.Summary.GROUP);
            tiebreak.forEach((column) => { column.sort = search.Sort.ASC; });
        } else {
            tiebreak = [search.createColumn({ name: "internalid", sort: search.Sort.ASC })];
        }
        const options = { type, columns: [...sorted, ...tiebreak, ...unsorted.filter((column) => tiebreak.indexOf(column) < 0)] };
        if (filters) options.filters = filters;
        return first ? mynt$first(search.create(options), cols, columns, references) : mynt$results(search.create(options), cols, columns, references, limit);
    }

    function mynt$columns(columns) {
        return columns.map((spec) => {
            const options = typeof spec === "string" ? { name: spec } : { name: spec.name };
            if (typeof spec !== "string" && spec.join) options.join = spec.join;
            if (typeof spec !== "string" && spec.sort) options.sort = search.Sort[spec.sort];
            if (typeof spec !== "string" && spec.summary) options.summary = search.Summary[spec.summary];
            return search.createColumn(options);
        });
    }

    function execute(context) {
        const customers = mynt$search(
            search.Type.CUSTOMER,
            ["email"],
            [],
            [
                ["email", search.Operator.ISNOTEMPTY, ""],
                "and",
                ["comments", search.Operator.ISEMPTY, ""]
            ]
        );

        for (const row of customers) {
            log.debug({
                title: "execute",
                details: row.email
            });

            const customer = record.load({
                type: record.Type.CUSTOMER,
                id: row.id
            });

            customer.setValue({
                fieldId: "comments",
                value: "Reviewed by Mynt"
            });

            customer.save();
        }
    }

    return { execute };
});
"
`;
