{
  "name": "@felixdivall/mynt",
  "version": "0.1.0",
  "description": "Mynt: a semantic source language that compiles to SuiteScript 2.1",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mynt": "./bin/mynt.js"
  },
  "files": [
    "bin",
    "dist",
    "schemas",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "netsuite",
    "suitescript",
    "compiler",
    "language",
    "lsp"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mynt": "tsx src/cli/main.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "grammar": "pnpm --dir tree-sitter-mynt run",
    "grammar:generate": "pnpm --dir tree-sitter-mynt run generate",
    "grammar:test": "pnpm --dir tree-sitter-mynt run test",
    "zed:dev": "node scripts/zed-dev.mjs"
  },
  "dependencies": {
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "acorn": "^8.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531"
}
